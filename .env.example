# No credentials needed — the DDGS backend is unauthenticated search, so
# this file (and .env in general) is entirely optional.
#
# Only these two overrides exist, and both have sane defaults if omitted
# (cache path defaults to a file in the OS temp dir, which stays writable
# even on hosts with an ephemeral/read-only app directory, e.g. Render free tier):
CACHE_TTL_HOURS=1
CACHE_PATH=cache.sqlite3
